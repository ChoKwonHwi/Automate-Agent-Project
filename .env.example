# .env.example 을 .env 로 복사한 뒤 값을 채운다. .env 는 커밋하지 않는다.

# --- LLM (Ollama, 로컬 GPU) ---
OLLAMA_HOST=http://localhost:11434
LLM_MODEL=qwen3:8b
LLM_NUM_CTX=8192

# --- 임베딩 / 리랭커 ---
EMBEDDING_MODEL=BAAI/bge-m3
# 색인은 GPU(auto), 질문 임베딩은 CPU — GPU 8GB 를 LLM · 리랭커에 양보 (PRD 8.3)
EMBEDDING_DEVICE=auto
QUERY_EMBEDDING_DEVICE=cpu
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# 검색 방식: hybrid(기본, dense + BM25) · dense · bm25
SEARCH_MODE=hybrid
# 일상어 → 규정 용어 사전 확장 (data/glossary.csv)
QUERY_GLOSSARY=on
# 리랭커: 상위 20개 재정렬 + 근거 오용 게이트 (GPU, 검색당 약 0.35초)
RERANKER=on

# --- 국가법령정보 Open API (open.law.go.kr 승인 후 발급되는 OC 값) ---
LAW_API_OC=

# --- 협업툴 (W5) ---
NOTION_TOKEN=
NOTION_DB_ID=
SLACK_BOT_TOKEN=
SLACK_CHANNEL=

# --- 관측성 (W6, Langfuse self-host) ---
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
