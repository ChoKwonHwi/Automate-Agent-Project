# .env.example 을 .env 로 복사한 뒤 값을 채운다. .env 는 커밋하지 않는다.

# --- LLM (Ollama, 로컬 GPU) ---
OLLAMA_HOST=http://localhost:11434
LLM_MODEL=qwen3:8b
LLM_NUM_CTX=8192

# --- 임베딩 / 리랭커 ---
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# --- 국가법령정보 Open API (open.law.go.kr 승인 후 발급되는 OC 값) ---
LAW_API_OC=

# --- 협업툴 (W5) ---
NOTION_TOKEN=
NOTION_DB_ID=
SLACK_BOT_TOKEN=
SLACK_CHANNEL=

# --- 관측성 (W6, Langfuse self-host) ---
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
